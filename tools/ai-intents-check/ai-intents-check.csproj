<Project Sdk="Microsoft.NET.Sdk">

  <!-- Local paths (Valheim install). Same import as src/Companions/Companions.csproj: Environment.props is not
       committed, so the defaults below are the standard Steam install. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\Environment.props" Condition="Exists('$(MSBuildThisFileDirectory)..\..\Environment.props')" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AiIntentsCheck</AssemblyName>
    <RootNamespace>AiIntentsCheck</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- CS0436: Stubs.cs shadows the game's ObjectDB on purpose (see the comment there) - the real one cannot even
         be loaded outside the game, and OrderItems.Known is written for the "no database yet" case. -->
    <NoWarn>$(NoWarn);0436</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(ValheimDir)\valheim_Data\Managed</ManagedDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(ValheimDir)\BepInEx\core</BepInExCoreDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Compile-time only (Private="false"): Program.cs resolves them at run time from the paths baked in below, the
       same way the game loads the mod (AssemblyResolve -> valheim_Data\Managed + BepInEx\core). BepInEx is the one
       the harness really loads at run time (ConfigEntry), so it travels next to the exe. -->
  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExCoreDir)\BepInEx.dll" Private="true" />
    <Reference Include="assembly_valheim" HintPath="$(ManagedDir)\assembly_valheim.dll" Private="false" />
    <!-- Localization lives in assembly_guiutils, not in assembly_valheim (MHR_List.Local reads it) -->
    <Reference Include="assembly_guiutils" HintPath="$(ManagedDir)\assembly_guiutils.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>

  <!-- The build paths, so the harness looks for the game assemblies in the same folders the build used
       (Program.InstallAssemblyProbe reads these). -->
  <ItemGroup>
    <AssemblyMetadata Include="ManagedDir" Value="$(ManagedDir)" />
    <AssemblyMetadata Include="BepInExCoreDir" Value="$(BepInExCoreDir)" />
  </ItemGroup>

  <!-- THE REAL SOURCES. The word nets are pure on purpose (see the summary of each file), so they are compiled
       straight from src/ - nothing is copied and nothing is reimplemented. Stubs.cs holds the few members of the
       Unity/config side those files touch (and only those). -->
  <ItemGroup>
    <Compile Include="..\..\src\Companions\AI\LlmIntent.cs" Link="src\AI\LlmIntent.cs" />
    <Compile Include="..\..\src\Companions\AI\RadialIntent.cs" Link="src\AI\RadialIntent.cs" />
    <Compile Include="..\..\src\Companions\AI\PickupIntent.cs" Link="src\AI\PickupIntent.cs" />
    <Compile Include="..\..\src\Companions\AI\GatherIntent.cs" Link="src\AI\GatherIntent.cs" />
    <Compile Include="..\..\src\Companions\AI\InteractionIntent.cs" Link="src\AI\InteractionIntent.cs" />
    <Compile Include="..\..\src\Companions\AI\OrderItems.cs" Link="src\AI\OrderItems.cs" />
    <Compile Include="..\..\src\Companions\AI\CompanionNames.cs" Link="src\AI\CompanionNames.cs" />
  <Compile Include="..\..\src\Companions\AI\BuildCatalog.cs" Link="src\AI\BuildCatalog.cs" />
  <Compile Include="..\..\src\Companions\AI\BuildTemplates.cs" Link="src/AI/BuildTemplates.cs" />
    <Compile Include="..\..\src\Companions\AI\BuildBlueprintParser.cs" Link="src/AI/BuildBlueprintParser.cs" />
  <Compile Include="..\..\src\Companions\AI\LevelIntent.cs" Link="src/AI/LevelIntent.cs" />
    <!-- P2 (multi-build): the tile arithmetic of the route map (no Unity in it, on purpose) -->
    <Compile Include="..\..\src\Companions\AI\NavTileMath.cs" Link="src/AI/NavTileMath.cs" />
    <!-- P1 (04/11/2026): the classification of a placement failure (the support gate of the build) - pure string -> class -->
    <Compile Include="..\..\src\Companions\AI\BuildFailure.cs" Link="src/AI/BuildFailure.cs" />
    <!-- P1 (04/11/2026): structure or furniture (how far a piece may move from the plan's pose) - pure name -> kind -->
    <Compile Include="..\..\src\Companions\AI\BuildPieceKind.cs" Link="src/AI/BuildPieceKind.cs" />
    <!-- P1 (04/11/2026): the window of the direct support of a piece (which plan index the group pulls next) - pure geometry -->
    <Compile Include="..\..\src\Companions\AI\BuildSupportBelow.cs" Link="src/AI/BuildSupportBelow.cs" />
    <!-- P1 (04/11/2026): the body window of the placement check (blocked_by_player) - pure arithmetic -->
    <Compile Include="..\..\src\Companions\AI\BuildBody.cs" Link="src/AI/BuildBody.cs" />
    <!-- 11/11/2026 (Run 13): the surface the walk to a piece goes to (the same storey first, then the highest one) - pure -->
    <Compile Include="..\..\src\Companions\AI\BuildWalkSpot.cs" Link="src/AI/BuildWalkSpot.cs" />
    <!-- 11/11/2026 (Run 14): where a companion of the site steps to when another one has to place a piece on its body - pure -->
    <Compile Include="..\..\src\Companions\AI\BuildAsideSpot.cs" Link="src/AI/BuildAsideSpot.cs" />
    <!-- 11/11/2026 (Run 14): how far apart the crew builds (a shared plan is not walked in a line) - pure -->
    <Compile Include="..\..\src\Companions\AI\BuildSpread.cs" Link="src/AI/BuildSpread.cs" />
    <!-- Lote 1 (11/11/2026): does the order still need a crafting station (template/single piece x blueprint switch) - pure -->
    <Compile Include="..\..\src\Companions\AI\BuildStationCover.cs" Link="src/AI/BuildStationCover.cs" />
    <!-- 11/11/2026 (the build panel): the material need of a plan (prefab -> count folded through the costs) - pure -->
    <Compile Include="..\..\src\Companions\AI\BuildMaterials.cs" Link="src/AI/BuildMaterials.cs" />
    <!-- 11/11/2026: why a .blueprint line does not become part of the plan - the two strings ARE the report's
         skippedReasons contract (BuildBlueprintReport + DevBridge blueprints.inspect) - pure -->
    <Compile Include="..\..\src\Companions\AI\BuildBlueprintSkip.cs" Link="src/AI/BuildBlueprintSkip.cs" />
    <!-- 11/11/2026: the LLM provider table of the panel (the dropdown fills Url+Model) - pure by design, its own
         docstring says it can be checked outside the game -->
    <Compile Include="..\..\src\Companions\AI\LlmProviders.cs" Link="src/AI/LlmProviders.cs" />
    <Compile Include="..\..\src\Companions\AI\MHR_Owner.cs" Link="src\AI\MHR_Owner.cs" />
    <Compile Include="..\..\src\Companions\Core\MHR_List.cs" Link="src\Core\MHR_List.cs" />
  </ItemGroup>

</Project>
