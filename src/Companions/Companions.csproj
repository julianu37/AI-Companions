<Project Sdk="Microsoft.NET.Sdk">

  <!-- Local paths (Valheim install, deploy folder). Copy Environment.props.example
       at the repo root to Environment.props and edit it; that file is not committed. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\Environment.props" Condition="Exists('$(MSBuildThisFileDirectory)..\..\Environment.props')" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Companions</AssemblyName>
    <RootNamespace>Companions</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <DebugType>portable</DebugType>
    <!-- Game assemblies are referenced in place and never copied next to the mod (every <Reference> below is
         Private="false"). Package assemblies (Whisper.net) DO go to the build output so the DeployWhisperNet target
         can pick the ones the plugin folder needs; nothing is copied next to the mod automatically. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(ValheimDir)\valheim_Data\Managed</ManagedDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(ValheimDir)\BepInEx\core</BepInExCoreDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- STT local (spike do Whisper.net in-process). No net472 o pacote resolve o alvo netstandard2.0, que usa o
       loader DllImport (System.Memory para Span<T>, Microsoft.Bcl.AsyncInterfaces para IAsyncDisposable).
       O Whisper.net.Runtime traz os nativos em runtimes\win-x64 (whisper.dll + ggml-*.dll).
       O Whisper.net 1.9.1 arrasta Microsoft.Extensions.AI.Abstractions -> System.Text.Json SO por causa do
       WhisperSpeechToTextClient (que nao usamos): os assets desses dois ficam de fora para nao levar
       System.Text.Json (e a familia) para dentro do Mono do Unity. O DeployWhisperNet abaixo copia apenas uma
       lista fechada de DLLs - veja docs/re/stt-whisper-net-spike.md. -->
  <ItemGroup>
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.2.0" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="10.0.2" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <!-- TTS local (Fase 3.4): Kokoro-82M via sherpa-onnx. O pacote gerenciado resolve o alvo netstandard2.0 (roda no
       net472, como o Whisper.net); o runtime win-x64 traz os nativos em runtimes\win-x64\native
       (sherpa-onnx-c-api.dll + onnxruntime.dll). O pacote gerenciado ARRASTA todos os runtimes (android, linux,
       osx, win-arm64, win-x86) como dependencia: as referencias abaixo com ExcludeAssets="all" desligam esses
       assets (mesmo truque do System.Text.Json acima) para nao copiar ~300 MB de nativos de outras plataformas
       para o bin. So o win-x64 e usado. Ver AI/CompanionTts.cs e docs/re/tts-kokoro-sherpa-onnx.md. -->
  <ItemGroup>
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="1.13.8" GeneratePathProperty="true" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.android-arm64" Version="1.13.8" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.android-x64" Version="1.13.8" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.linux-arm64" Version="1.13.8" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.linux-x64" Version="1.13.8" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.osx-arm64" Version="1.13.8" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.osx-x64" Version="1.13.8" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-arm64" Version="1.13.8" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x86" Version="1.13.8" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExCoreDir)\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCoreDir)\0Harmony.dll" Private="false" />
    <Reference Include="assembly_valheim" HintPath="$(ManagedDir)\assembly_valheim.dll" Private="false" />
    <Reference Include="assembly_utils" HintPath="$(ManagedDir)\assembly_utils.dll" Private="false" />
    <Reference Include="assembly_guiutils" HintPath="$(ManagedDir)\assembly_guiutils.dll" Private="false" />
    <Reference Include="Splatform" HintPath="$(ManagedDir)\Splatform.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(ManagedDir)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ManagedDir)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(ManagedDir)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="UnityEngine.AIModule" HintPath="$(ManagedDir)\UnityEngine.AIModule.dll" Private="false" />
    <Reference Include="UnityEngine.JSONSerializeModule" HintPath="$(ManagedDir)\UnityEngine.JSONSerializeModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(ManagedDir)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedDir)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <!-- DevBridge (development tool, [Advanced] DevBridge): ScreenCapture.CaptureScreenshot -->
    <Reference Include="UnityEngine.ScreenCaptureModule" HintPath="$(ManagedDir)\UnityEngine.ScreenCaptureModule.dll" Private="false" />
  </ItemGroup>

  <!-- UI textures, loaded at runtime by manifest resource name
       (e.g. Companions.Resources.Textures.UI.RadialMenu.Farm.png). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Textures\UI\**\*.png">
      <LogicalName>Companions.Resources.Textures.UI.$([System.String]::Copy('%(RecursiveDir)').Replace('\', '.').Replace('/', '.'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Optional: copy the built DLL into BepInEx/plugins after each build. -->
  <Target Name="DeployToPlugins" AfterTargets="Build" Condition="'$(DeployDir)' != ''">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" />
    <Message Importance="high" Text="Deployed $(TargetFileName) to $(DeployDir)" />
  </Target>

  <!-- STT spike: the Whisper.net assemblies and its native libraries next to the plugin DLL, so Whisper.net finds
       them without the game folder being involved. The managed list is a closed allow-list: Whisper.net plus the
       netstandard2.0 shims it actually loads (Bcl.AsyncInterfaces for IAsyncDisposable, System.Memory for Span<T>
       and its own dependencies). Microsoft.Extensions.AI.Abstractions / System.Text.Json stay out on purpose.
       The natives keep their runtimes\win-x64 tree, which is exactly where Whisper.net's loader looks
       (NativeLibraryLoader.GetRuntimePaths -> <LibraryPath dir>\runtimes\win-x64). -->
  <Target Name="DeployWhisperNet" AfterTargets="DeployToPlugins" Condition="'$(DeployDir)' != ''">
    <ItemGroup>
      <WhisperManaged Include="@(ReferenceCopyLocalPaths)"
                      Condition="'%(Filename)' == 'Whisper.net'
                              Or '%(Filename)' == 'Microsoft.Bcl.AsyncInterfaces'
                              Or '%(Filename)' == 'System.Threading.Tasks.Extensions'
                              Or '%(Filename)' == 'System.Memory'
                              Or '%(Filename)' == 'System.Buffers'
                              Or '%(Filename)' == 'System.Numerics.Vectors'
                              Or '%(Filename)' == 'System.Runtime.CompilerServices.Unsafe'" />
      <WhisperNative Include="$(TargetDir)runtimes\win-x64\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(WhisperManaged)" DestinationFolder="$(DeployDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(WhisperNative)" DestinationFolder="$(DeployDir)\runtimes\win-x64" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed @(WhisperManaged->Count()) Whisper.net managed DLL(s) and @(WhisperNative->Count()) native DLL(s) to $(DeployDir) (managed: @(WhisperManaged->'%(Filename)%(Extension)', ', '))" />
  </Target>

  <!-- TTS (Fase 3.4): the sherpa-onnx managed assembly and its native libraries next to the plugin DLL. The native
       tree keeps the package layout, runtimes\win-x64\native\, which is where CompanionTts looks for
       sherpa-onnx-c-api.dll + onnxruntime.dll (it preloads them by absolute path - see EnsureNativeLibraries).

       The natives are copied from the NuGet package folder itself (Pkg... path from GeneratePathProperty): a
       RID-less build does NOT copy runtimes\<rid>\native\* to the output (only runtimes\<rid>\*.dll, which is the
       non-standard layout the Whisper.net.Runtime package uses), so $(TargetDir) has nothing to pick up. -->
  <Target Name="DeploySherpaOnnx" AfterTargets="DeployToPlugins" Condition="'$(DeployDir)' != ''">
    <ItemGroup>
      <SherpaManaged Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'sherpa-onnx'" />
      <SherpaNative Include="$(Pkgorg_k2fsa_sherpa_onnx_runtime_win-x64)\runtimes\win-x64\native\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(SherpaManaged)" DestinationFolder="$(DeployDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(SherpaNative)" DestinationFolder="$(DeployDir)\runtimes\win-x64\native" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed @(SherpaManaged->Count()) sherpa-onnx managed DLL(s) and @(SherpaNative->Count()) native DLL(s) from &quot;$(Pkgorg_k2fsa_sherpa_onnx_runtime_win-x64)&quot; to $(DeployDir)\runtimes\win-x64\native (managed: @(SherpaManaged->'%(Filename)%(Extension)', ', '); native: @(SherpaNative->'%(Filename)%(Extension)', ', '))" />
  </Target>

  <!-- UI strings (ModLocalization) live in Translations\<Language>.json and are read at runtime from next to
       the DLL: <DeployDir>\Translations\<Language>.json.
       Companion speech lines (SpeechConfig) live in Speech\<Language>.json, kept OUT of Translations\ on
       purpose: Jotunn's automatic localization loader treats Translations\<Folder>\*.json as a language and
       would mistake it for a language named "speech". -->
  <ItemGroup>
    <TranslationFiles Include="$(MSBuildThisFileDirectory)..\..\Translations\**\*.json" />
    <SpeechFiles Include="$(MSBuildThisFileDirectory)..\..\Speech\**\*.json" />
    <LicenseFiles Include="$(MSBuildThisFileDirectory)..\..\LICENSES\**\*" />
  </ItemGroup>

  <!-- The third-party licence texts travel WITH the binaries they cover (the package redistributes
       Whisper.net/whisper.cpp/sherpa-onnx/onnxruntime and the Kokoro/espeak-ng data), so they are
       deployed next to the DLL as <DeployDir>\LICENSES\. -->
  <Target Name="DeployLicenses" AfterTargets="Build" Condition="'$(DeployDir)' != '' and '@(LicenseFiles)' != ''">
    <Copy SourceFiles="@(LicenseFiles)" DestinationFiles="@(LicenseFiles->'$(DeployDir)\LICENSES\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed @(LicenseFiles->Count()) third-party licence file(s) to $(DeployDir)\LICENSES" />
  </Target>

  <Target Name="DeployTranslations" AfterTargets="Build" Condition="'$(DeployDir)' != '' and ('@(TranslationFiles)' != '' or '@(SpeechFiles)' != '')">
    <Copy SourceFiles="@(TranslationFiles)" DestinationFiles="@(TranslationFiles->'$(DeployDir)\Translations\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(SpeechFiles)" DestinationFiles="@(SpeechFiles->'$(DeployDir)\Speech\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed @(TranslationFiles->Count()) translation file(s) to $(DeployDir)\Translations and @(SpeechFiles->Count()) speech file(s) to $(DeployDir)\Speech" />
  </Target>

</Project>
