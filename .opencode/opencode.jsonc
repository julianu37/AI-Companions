{
  "$schema": "https://opencode.ai/config.json",
  // experimental.subagent_depth: a subagente pode chamar outro subagente (arquiteto -> especialista -> executor).
  "experimental": {
    "subagent_depth": 2
  },
  "references": {
    "bepinex": {
      "repository": "BepInEx/BepInEx",
      "description": "Fonte oficial do BepInEx (plugin, config, logging, Harmony). Use para confirmar APIs de plugin/config/patches."
    },
    "jotunn": {
      "repository": "Valheim-Modding/Jotunn",
      "description": "Fonte oficial do Jotunn (Managers, prefabs, itens, GUI, localização). Use para confirmar APIs do framework."
    },
    "offline-companions": {
      "repository": "MaddhattrRocks/Offline-Companions-Reborn",
      "description": "Mod companheiro (MIT, uso livre) para Valheim 1.0: IA de movimento/combate, jobs de coleta/farm/fish/hunt/cook/smelt/repair, UI (menu radial, painéis, HUD), patches. Consulte para ideias e implementação - ver docs/references.md."
    },
    "mod-buildorders": {
      "repository": "HardHeadHackerHead/valheim-mods",
      "description": "BuildOrders (MIT) + AICompanion (Quad's Companion): construção por plano com NPC. Referência para ordem de construção, dependência explícita de apoio e portão de estação por peça. Ver docs/re/mods/HardHeadHackerHead-valheim-mods-BuildOrders.md."
    },
    "mod-planbuild": {
      "repository": "sirskunkalot/PlanBuild",
      "description": "PlanBuild (WTFPL, JOTUNN-ONLY): o formato .blueprint que lemos e a execução por fantasma que é WearNTear (apoio = veredito do jogo). Ideia, não código - ver docs/re/mods/sirskunkalot-PlanBuild.md."
    },
    "mod-serverside": {
      "repository": "Sergentval/Valheim-serverside",
      "description": "Receita de posse de ZDO em servidor dedicado (MIT, alpha): m_sessionID por reflexão + SetOwner(serverUid) + DataRevision++. Referência para a pendência (5) - ver docs/re/mods/Sergentval-Valheim-serverside.md."
    }
  },
  "mcp": {
    "servers": {
      "alvin": {
        "type": "local",
        "command": [
          "C:\\Users\\revenda33\\AppData\\Local\\Programs\\Python\\Python312\\Scripts\\mcp-proxy.exe",
          "http://localhost:5050/sse"
        ]
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "valheim-devbridge": {
        "type": "local",
        "command": [
          "python",
          "C:\\Users\\revenda33\\Desktop\\ValheinCompanions\\tools\\mcp-devbridge\\mcp_devbridge.py"
        ],
        "enabled": true
      },
      "learn": {
        "type": "remote",
        "url": "https://learn.microsoft.com/api/mcp"
      }
    }
  }
}
