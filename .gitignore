# amostras dos runs do DevBridge (dados de uma sessao, nao fazem parte do repo)
# -watch.log e -site.jsonl: o free_run_acceptance.py le como instrumento, nao como fonte
tools/mcp-devbridge/*.jsonl
tools/mcp-devbridge/*-watch.log
tools/mcp-devbridge/*-site.jsonl
tools/mcp-devbridge/free-run-site-*.jsonl
# rascunhos de analise de um run (despejos da cena, indices): dado de uma sessao, nao fonte
tools/mcp-devbridge/scratch/
# despejos da cena (build.pieces) de um run: a entrada do reconcile_scene.py, nao uma fonte
tools/mcp-devbridge/scene-*.json
tools/plan-probe/plan-dump.txt

# estado local do harness (settings.local.json, memoria de sessao) - o harness versionado e .claude/agents|skills|settings.json
.claude/settings.local.json
.claude/worktrees/

# clones de referencia de terceiros (nao entram no repo)
.refs/

# workspace do plano (scratch do executor de planos; o historico e o git)
.superpowers/
